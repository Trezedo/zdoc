{
    "$schema": "https://json.schemastore.org/prettierrc",
    "semi": true,
    "tabWidth": 4,
    "singleQuote": false,
    "printWidth": 100,
    "trailingComma": "all",
    "plugins": ["@ianvs/prettier-plugin-sort-imports"],
    "importOrder": [
        "<TYPES>",
        "<TYPES>^[./]",
        "",
        "<THIRD_PARTY_MODULES>",
        "",
        "^@/(.*)$",
        "^@/styles/",
        "",
        "^[./]",
        "",
        ".(?:css|scss|sass)$"
    ],
    "importOrderSafeSideEffects": ["^@/styles/"]
}
